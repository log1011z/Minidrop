<Window x:Class="MiniDrop.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MiniDrop.Windows.ViewModels"
        xmlns:views="clr-namespace:MiniDrop.Windows.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MiniDrop" Width="560" Height="740"
        MinWidth="400" MinHeight="440"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        Foreground="{StaticResource TextBrush}" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Drop="Window_Drop">

    <shell:WindowChrome.WindowChrome>
        <!-- CaptionHeight=0：标题栏拖拽用 DragMove 自行处理，按钮点击不经过 chrome 命中测试 -->
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 文件行：圆角 8 -->
        <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
            <Border Margin="0,4" Padding="10" Background="{StaticResource ChipBackground}" CornerRadius="10" ToolTip="右键可复制文件、打开所在文件夹或仅下载">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="下载并打开" Command="{Binding ActionCommand}" />
                        <MenuItem Header="仅下载" Command="{Binding DownloadOnlyCommand}" />
                        <MenuItem Header="复制文件" Command="{Binding CopyFileCommand}" />
                        <MenuItem Header="打开所在文件夹" Command="{Binding RevealFileCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                <Button Command="{Binding ActionCommand}" Padding="0" Margin="0,0,0,8" ToolTip="点击放大预览"
                        Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                    <Grid MinHeight="100" MaxHeight="200" Background="#E8ECF3">
                        <TextBlock Text="{Binding PreviewLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" />
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" MaxHeight="200" />
                    </Grid>
                </Button>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Background="White" CornerRadius="8" Width="36" Height="40" Margin="0,0,10,0">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <WrapPanel Margin="0,4,0,0">
                            <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0" />
                        </WrapPanel>
                    </StackPanel>
                    <Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding ActionCommand}"
                            Padding="10,4" VerticalAlignment="Center">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style>
                    </Button>
                </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 消息卡：白底圆角 8，悬停高亮 -->
        <DataTemplate DataType="{x:Type vm:MessageViewModel}">
            <Border Margin="16,5" Padding="16,14" CornerRadius="12" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource CardBackground}" />
                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FCFDFF" />
                                <Setter Property="BorderBrush" Value="#C8D6F0" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="删除" Click="DeleteMenuItem_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="重试"
                                Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Id}" Padding="10,2"
                                Visibility="{Binding ShowRetry, Converter={StaticResource BoolToVis}}" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DeviceName}" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,0,0,0" />
                        </Grid>
                    </DockPanel>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" Margin="0,3,0,0"
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                    <views:SelectableMessageText MessageText="{Binding Text}" Margin="0,10,0,0" FontSize="14"
                               FontFamily="{StaticResource AppFont}" Foreground="{StaticResource TextBrush}"
                               MaxHeight="{Binding TextMaxHeight}"
                               SizeChanged="MessageText_SizeChanged"
                               Loaded="MessageText_Loaded" DataContextChanged="MessageText_DataContextChanged"
                               Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}">
                        <views:SelectableMessageText.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="复制所选文字" Command="ApplicationCommands.Copy"
                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="删除" Click="DeleteMenuItem_Click" />
                            </ContextMenu>
                        </views:SelectableMessageText.ContextMenu>
                    </views:SelectableMessageText>
                    <Button Content="{Binding TextToggleLabel}" Command="{Binding ToggleTextCommand}"
                            Style="{StaticResource QuietButton}"
                            HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,2"
                            Visibility="{Binding ShowTextToggle, Converter={StaticResource BoolToVis}}" />

                    <ItemsControl ItemsSource="{Binding Files}" Margin="0,6,0,0">
                        <ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding Files.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- 圆角根容器：最大化时直角并让出边框 -->
    <Border x:Name="RootBorder" Background="{StaticResource WindowBackground}" CornerRadius="8"
            BorderBrush="#D9D9D9" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏：MouseLeftButtonDown 拖拽，双击最大化 -->
            <Border Grid.Row="0" Background="{StaticResource WindowBackground}" Padding="12,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                   >
                <DockPanel Height="52" LastChildFill="True">
                    <Border DockPanel.Dock="Left" Background="{StaticResource AccentLightBrush}" CornerRadius="9" Width="30" Height="30" VerticalAlignment="Center" Margin="4,0,10,0">
                        <Image Source="pack://application:,,,/MiniDrop.Windows;component/app.ico" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock DockPanel.Dock="Left" Text="MiniDrop" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE72C;" Click="RefreshTitleButton_Click"
                                ToolTip="刷新 (F5)" />
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE713;" Click="SettingsTitleButton_Click"
                                ToolTip="设置" />
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource CaptionButton}" x:Name="MaxRestoreButton" Content="&#xE922;" Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="CloseButton_Click" />
                    </StackPanel>
                    <!-- 标题栏可拖拽区域 -->
                    <Border Background="Transparent" />
                </DockPanel>
            </Border>

            <!-- 提示与加载更早 -->
            <StackPanel Grid.Row="1" Margin="20,8,20,12">
                <Border Background="#FFF4CE" Padding="10,6" CornerRadius="4"
                        Visibility="{Binding ShowUnconfigured, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="请先完成 WebDAV 设置（右上角 ⚙）" Foreground="#8A6A00" />
                </Border>
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="加载更早" Style="{StaticResource QuietButton}" Command="{Binding LoadOlderAsyncCommand}" Padding="10,4" Visibility="{Binding ShowLoadOlder, Converter={StaticResource BoolToVis}}" />
                    <StackPanel><TextBlock Text="最近投递" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="文件与文字，随手送达" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" /></StackPanel>
                </DockPanel>
            </StackPanel>

            <!-- 时间线 -->
            <ListBox Grid.Row="2" x:Name="TimelineList" ItemsSource="{Binding Timeline}"
                     Foreground="{StaticResource TextBrush}"
                     BorderThickness="0" Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                     ScrollViewer.PanningMode="VerticalOnly"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1"
                     ScrollViewer.ScrollChanged="TimelineList_ScrollChanged"
                     PreviewMouseWheel="TimelineList_PreviewMouseWheel" PreviewMouseDown="TimelineList_PreviewMouseDown"
                     PreviewKeyDown="TimelineList_PreviewKeyDown"
                     ScrollViewer.IsDeferredScrollingEnabled="False"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Focusable" Value="False" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Timeline.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#AABBD8" HorizontalAlignment="Center" />
                <TextBlock Text="从一次投递开始" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,6" />
                <TextBlock Text="拖入文件，或在下方写点什么" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 输入栏 -->
            <Border Grid.Row="3" Background="{StaticResource CardBackground}" Padding="12" Margin="16,12,16,0" CornerRadius="12"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <ScrollViewer MaxHeight="108" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Attachments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,4" Background="{StaticResource ChipBackground}">
                                        <Button DockPanel.Dock="Right" Content="×" ToolTip="移除附件" Padding="8,2"
                                                Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" Margin="8,4" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Grid>
                        <TextBlock Text="写点什么，或拖入文件…" Margin="9,6,0,0" Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding InputText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="InputBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderBrush="Transparent"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46" MaxHeight="140"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="InputBox_PreviewKeyDown"
                                 ToolTip="Ctrl+V 粘贴截图、文件或文字，附件可与文字一起发送" />
                    </Grid>
                    <DockPanel Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right" Content="发送 ↑" Style="{StaticResource AccentButton}" Command="{Binding SendCommand}" FontWeight="SemiBold" MinWidth="80" />
                        <Button DockPanel.Dock="Left" Content="＋ 添加文件" Style="{StaticResource QuietButton}" Click="AddFilesButton_Click" Margin="0" />
                        <TextBlock Text="Enter 发送 · Shift+Enter 换行" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="4,0,8,0" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 状态栏 -->
            <Border Grid.Row="4" Background="{StaticResource WindowBackground}" Padding="20,8">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" FontSize="12" />
            </Border>
        </Grid>
    </Border>
</Window>
