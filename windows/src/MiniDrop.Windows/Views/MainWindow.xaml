<Window x:Class="MiniDrop.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MiniDrop.Windows.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MiniDrop" Width="520" Height="680"
        MinWidth="400" MinHeight="440"
        FontFamily="{StaticResource AppFont}" FontSize="13"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Drop="Window_Drop">

    <shell:WindowChrome.WindowChrome>
        <!-- CaptionHeight=0：标题栏拖拽用 DragMove 自行处理，按钮点击不经过 chrome 命中测试 -->
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 文件行：圆角 8 -->
        <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
            <Border Margin="0,3" Padding="10,7" Background="{StaticResource ChipBackground}" CornerRadius="8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="{Binding ActionText}" Command="{Binding ActionCommand}"
                            Padding="10,3" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   MaxWidth="260" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding SizeText, StringFormat=' · {0}'}" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StateText}" Foreground="{StaticResource AccentBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- 消息卡：白底圆角 8，悬停高亮 -->
        <DataTemplate DataType="{x:Type vm:MessageViewModel}">
            <Border Margin="12,5" Padding="12,9" CornerRadius="8" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource CardBackground}" />
                        <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FBFDFF" />
                                <Setter Property="BorderBrush" Value="#BFD4E8" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="删除" Click="DeleteMenuItem_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="重试"
                                Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding Id}" Padding="10,2"
                                Visibility="{Binding ShowRetry, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock Text="{Binding DeviceName, StringFormat=' · {0}'}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}"
                                       FontSize="12" Margin="10,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}" Margin="0,3,0,0"
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="20"
                               Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}">
                        <TextBlock.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="复制" Click="CopyMenuItem_Click" />
                                <MenuItem Header="删除" Click="DeleteMenuItem_Click" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding Files}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- 圆角根容器：最大化时直角并让出边框 -->
    <Border x:Name="RootBorder" Background="{StaticResource WindowBackground}" CornerRadius="8"
            BorderBrush="#D9D9D9" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 自定义标题栏：MouseLeftButtonDown 拖拽，双击最大化 -->
            <Border Grid.Row="0" Background="{StaticResource WindowBackground}" Padding="12,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                   >
                <DockPanel Height="40" LastChildFill="True">
                    <Image DockPanel.Dock="Left" Source="pack://application:,,,/app.ico" Width="16" Height="16"
                           RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0" />
                    <TextBlock DockPanel.Dock="Left" Text="MiniDrop" FontWeight="SemiBold" FontSize="13"
                               VerticalAlignment="Center" Foreground="#1B1B1B" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE72C;" Click="RefreshTitleButton_Click"
                                ToolTip="刷新 (F5)" />
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE713;" Click="SettingsTitleButton_Click"
                                ToolTip="设置" />
                        <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource CaptionButton}" x:Name="MaxRestoreButton" Content="&#xE922;" Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="CloseButton_Click" />
                    </StackPanel>
                    <!-- 标题栏可拖拽区域 -->
                    <Border Background="Transparent" />
                </DockPanel>
            </Border>

            <!-- 提示与加载更早 -->
            <StackPanel Grid.Row="1" Margin="16,10,16,0">
                <Border Background="#FFF4CE" Padding="10,6" CornerRadius="4"
                        Visibility="{Binding ShowUnconfigured, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="请先完成 WebDAV 设置（右上角 ⚙）" Foreground="#8A6A00" />
                </Border>
                <Button Content="加载更早" Command="{Binding LoadOlderAsyncCommand}" HorizontalAlignment="Center"
                        Margin="0,8,0,0" Padding="16,5"
                        Visibility="{Binding ShowLoadOlder, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <!-- 时间线 -->
            <ListBox Grid.Row="2" x:Name="TimelineList" ItemsSource="{Binding Timeline}"
                     BorderThickness="0" Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" />

            <!-- 输入栏 -->
            <Border Grid.Row="3" Background="{StaticResource CardBackground}" Padding="16,10"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="发送 ↑" Style="{StaticResource AccentButton}"
                                Command="{Binding SendCommand}" FontWeight="SemiBold" MinWidth="76" />
                        <Button DockPanel.Dock="Right" Content="📎 添加文件" Click="AddFilesButton_Click" Margin="0,0,8,0" />
                        <TextBox x:Name="InputBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46" MaxHeight="140"
                                 VerticalScrollBarVisibility="Auto"
                                 KeyDown="InputBox_KeyDown" PreviewKeyDown="InputBox_PreviewKeyDown"
                                 ToolTip="支持拖入文件、Ctrl+V 粘贴文件或文字" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 状态栏 -->
            <Border Grid.Row="4" Background="{StaticResource WindowBackground}" Padding="16,5"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}"
                           TextTrimming="CharacterEllipsis" FontSize="12" />
            </Border>
        </Grid>
    </Border>
</Window>
